    <string name="how_to_use_title">How to use?</string>
    <string name="how_to_use_content">1. Choose your engines in Settings.\n2. Link the game folder or its mods folder.\n3. After reinstalling the app, link your folders again.</string>
    <string name="installation_guide_title">Installation Guide</string>
    <string name="guide_scoped_title">Scoped Storage Installation</string>
    <string name="guide_scoped_content">Choose the mod folder using the Android picker. Android/data may be restricted; use a folder or document provider offered by your game.</string>
    <string name="guide_external_title">External Storage Installation</string>
    <string name="guide_external_content">Choose the external engine folder, such as .PsychEngine, or its mods folder, and allow read and write access.</string>
    <string name="guide_funkin_mobile_title">Funkin Mobile Mods</string>
    <string name="guide_funkin_mobile_content">Enabling or disabling a mod moves its folder between mods and mods_disabled. Do not change these folders during the operation.</string>
    <string name="guide_engines_title">Engines Mods</string>
    <string name="guide_engines_content">Supported engines use modsList.txt to record which mods are active.</string>
    <string name="guide_unlinking_title">Why folders get unlinked?</string>
    <string name="guide_unlinking_content">Reinstalling, clearing app data or changes to the document provider may invalidate access. If this happens, select the folder again.</string>
