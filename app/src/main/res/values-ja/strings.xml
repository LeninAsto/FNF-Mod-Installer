    <string name="installation_guide_title">インストールガイド</string>
    <string name="guide_scoped_title">アクセスが制限された保存先</string>
    <string name="guide_scoped_content">Androidの選択画面でMODフォルダを選んでください。Android/dataへのアクセスが制限されている場合は、ゲームが提供するフォルダやドキュメントプロバイダを使用してください。</string>
    <string name="guide_external_title">外部ストレージ</string>
